{
  "manifest_version": 3,
  "name": "Unmuffle: Fix Bad Video Audio",
  "short_name": "Unmuffle",
  "version": "0.1.0",
  "description": "Make bad audio sound good. Removes hiss and room echo, brings dialogue forward and evens out the volume, live, on any tab.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Unmuffle",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["tabCapture", "offscreen", "storage"]
}
